---
import { reader } from '../lib/keystatic';
import { resolveNavItems } from '../lib/navigation';

const [settings, nav] = await Promise.all([
  reader.singletons.siteSettings.read(),
  reader.singletons.navigation.read(),
]);

const siteName = settings?.siteName ?? 'Portfolio';
const links = await resolveNavItems(nav?.footerLinks as any);
const note = nav?.footerNote ?? '';
const social = settings?.social ?? null;
---

<footer class="border-t border-neutral-800">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <div class="flex flex-wrap items-start justify-between gap-6">
      <div class="text-sm text-neutral-500">
        © {new Date().getFullYear()} {siteName}
        {note && <p class="mt-1 max-w-md whitespace-pre-wrap text-neutral-600">{note}</p>}
      </div>

      {links.length > 0 && (
        <nav class="flex flex-wrap gap-5 text-sm text-neutral-400">
          {links.map((link) => (
            <a
              href={link.href}
              class="hover:text-white"
              target={link.opensInNewTab ? '_blank' : undefined}
              rel={link.opensInNewTab ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      )}

      {social && (
        <div class="flex gap-3 text-sm text-neutral-400">
          {social.instagram && <a href={social.instagram} target="_blank" rel="noopener" class="hover:text-white">Instagram</a>}
          {social.linkedin && <a href={social.linkedin} target="_blank" rel="noopener" class="hover:text-white">LinkedIn</a>}
          {social.github && <a href={social.github} target="_blank" rel="noopener" class="hover:text-white">GitHub</a>}
        </div>
      )}
    </div>
  </div>
</footer>
