---
interface Props {
  heading: string | null;
  items: ReadonlyArray<{ question: string; answer: string }>;
}
const { heading, items } = Astro.props;
---

<section class="border-t border-neutral-800">
  <div class="mx-auto max-w-3xl px-6 py-20">
    {heading && <h2 class="text-3xl font-semibold">{heading}</h2>}
    <div class="mt-8 space-y-3">
      {items.map((item) => (
        <details class="group rounded-lg border border-neutral-800 bg-neutral-950 p-5">
          <summary class="cursor-pointer list-none text-lg font-medium text-neutral-100 marker:hidden">
            <span class="flex items-center justify-between">
              <span>{item.question}</span>
              <span class="ml-4 text-neutral-500 transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 whitespace-pre-wrap text-neutral-400">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
