---
interface Props {
  src: string;
  alt: string;
  caption: string | null;
  width: 'narrow' | 'wide' | 'full';
}
const { src, alt, caption, width } = Astro.props;

const containerClass = {
  narrow: 'max-w-2xl',
  wide: 'max-w-5xl',
  full: 'max-w-none',
}[width];
---

<section class="border-t border-neutral-800">
  <div class={`mx-auto ${containerClass} px-6 py-12`}>
    <figure>
      <img
        src={src}
        alt={alt}
        class="w-full rounded-lg border border-neutral-800"
        loading="lazy"
      />
      {caption && (
        <figcaption class="mt-3 text-center text-sm text-neutral-500">{caption}</figcaption>
      )}
    </figure>
  </div>
</section>
