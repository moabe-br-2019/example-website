---
interface Props {
  heading: string;
  subheading: string | null;
  ctaPrimary: { label: string | null; href: string | null };
  ctaSecondary: { label: string | null; href: string | null };
  backgroundImage: string | null;
}
const { heading, subheading, ctaPrimary, ctaSecondary, backgroundImage } = Astro.props;
---

<section class="relative overflow-hidden">
  {backgroundImage && (
    <>
      <img
        src={backgroundImage}
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-30"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/40 via-neutral-950/60 to-neutral-950"></div>
    </>
  )}
  <div class="relative mx-auto max-w-6xl px-6 py-24 text-center sm:py-32">
    <h1 class="bg-gradient-to-br from-white to-neutral-500 bg-clip-text text-5xl font-bold leading-tight text-transparent sm:text-7xl">
      {heading}
    </h1>
    {subheading && (
      <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-400">{subheading}</p>
    )}
    {(ctaPrimary?.label || ctaSecondary?.label) && (
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        {ctaPrimary?.label && ctaPrimary?.href && (
          <a
            href={ctaPrimary.href}
            class="rounded-md bg-white px-5 py-2.5 text-sm font-medium text-neutral-900 hover:bg-neutral-200"
          >
            {ctaPrimary.label}
          </a>
        )}
        {ctaSecondary?.label && ctaSecondary?.href && (
          <a
            href={ctaSecondary.href}
            class="rounded-md border border-neutral-700 px-5 py-2.5 text-sm font-medium text-neutral-200 hover:border-neutral-500"
          >
            {ctaSecondary.label}
          </a>
        )}
      </div>
    )}
  </div>
</section>
