---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { reader } from '../../lib/keystatic';
import { getFaviconUrl } from '../../lib/site';

const [servicesRaw, faviconUrl] = await Promise.all([
  reader.collections.services.all(),
  getFaviconUrl(),
]);
const services = servicesRaw
  .map((s) => ({ slug: s.slug, ...s.entry }))
  .sort((a, b) => a.order - b.order);
---

<BaseLayout title="Services" faviconUrl={faviconUrl}>
  <SiteHeader />
  <main class="mx-auto max-w-6xl px-6 py-16">
    <h1 class="text-4xl font-bold">Services</h1>
    <p class="mt-2 text-neutral-400">Every area we work in.</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <a href={`/services/${s.slug}`} class="block rounded-lg border border-neutral-800 bg-neutral-950 p-6 transition hover:border-neutral-500">
          <h2 class="text-xl font-semibold">{s.title}</h2>
          <p class="mt-2 text-sm text-neutral-400">{s.description}</p>
        </a>
      ))}
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
