---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { reader } from '../lib/keystatic';

export async function getStaticPaths() {
  // Slugs reserved by static routes — pages with these slugs are silently skipped.
  const RESERVED = new Set([
    'services',
    'projects',
    'contact',
    'approve',
    'api',
    'keystatic',
    '_astro',
  ]);
  const pages = await reader.collections.pages.all();
  return pages
    .filter((p) => !RESERVED.has(p.slug))
    .map((p) => ({ params: { slug: p.slug }, props: { entry: p.entry } }));
}

const { entry } = Astro.props as { entry: any };

const blocks = (entry.blocks ?? []) as Array<{ discriminant: string; value: any }>;
const seo = entry.seo ?? {};
---

<BaseLayout title={entry.title} description={seo.description ?? undefined}>
  {seo.noindex && <meta name="robots" content="noindex" slot="head" />}

  <SiteHeader />

  <main>
    <BlockRenderer blocks={blocks} />
  </main>

  <SiteFooter />
</BaseLayout>
