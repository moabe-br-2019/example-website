---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { reader } from '../../lib/keystatic';

const projectsRaw = await reader.collections.projects.all();
const projects = projectsRaw
  .map((p) => ({ slug: p.slug, ...p.entry }))
  .sort((a, b) => {
    const ad = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
    const bd = b.publishedAt ? new Date(b.publishedAt).getTime() : 0;
    return bd - ad;
  });

const fmtDate = (d: string | null) =>
  d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short' }) : '';
---

<BaseLayout title="Projects">
  <main class="mx-auto max-w-6xl px-6 py-16">
    <a href="/" class="text-sm text-neutral-400 hover:text-white">← Home</a>
    <h1 class="mt-4 text-4xl font-bold">Projects</h1>
    <p class="mt-2 text-neutral-400">A selection of the work we've shipped.</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <a
          href={`/projects/${p.slug}`}
          class="group block overflow-hidden rounded-lg border border-neutral-800 bg-neutral-950 transition hover:border-neutral-500"
        >
          {p.coverImage ? (
            <img
              src={p.coverImage}
              alt={p.title}
              class="aspect-video w-full object-cover transition group-hover:opacity-90"
              loading="lazy"
            />
          ) : (
            <div class="aspect-video w-full bg-gradient-to-br from-neutral-800 to-neutral-900" />
          )}
          <div class="p-5">
            <div class="flex items-center justify-between text-xs uppercase tracking-wider text-neutral-500">
              <span>{p.client}</span>
              {p.publishedAt && <time>{fmtDate(p.publishedAt)}</time>}
            </div>
            <h2 class="mt-2 text-lg font-semibold">{p.title}</h2>
            <p class="mt-2 line-clamp-3 text-sm text-neutral-400">{p.summary}</p>
            {p.tags?.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {p.tags.map((t) => (
                  <span class="rounded-full border border-neutral-700 px-2 py-0.5 text-xs text-neutral-400">
                    {t}
                  </span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>

    {projects.length === 0 && (
      <p class="mt-10 text-center text-neutral-500">No projects published yet.</p>
    )}
  </main>
</BaseLayout>
