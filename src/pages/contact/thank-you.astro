---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Message sent">
  <main class="mx-auto flex min-h-[70vh] max-w-xl flex-col items-center justify-center px-6 text-center">
    <div class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-full border border-green-500/30 bg-green-500/10 text-green-300">
      ✓
    </div>
    <h1 class="text-3xl font-bold">Message sent</h1>
    <p class="mt-3 text-neutral-400">
      We've received your message and will get back to you shortly. Thank you for reaching out!
    </p>
    <a
      href="/"
      class="mt-8 rounded-md border border-neutral-700 px-5 py-2.5 text-sm font-medium text-neutral-200 hover:border-neutral-500"
    >
      Back to home
    </a>
  </main>
</BaseLayout>
