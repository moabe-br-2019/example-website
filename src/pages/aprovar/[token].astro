---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDB, sha256Hex, type ProjectApproval } from '../../lib/db';

const { token } = Astro.params;

type ViewState =
  | { kind: 'invalid' }
  | { kind: 'expired'; approval: ProjectApproval }
  | { kind: 'decided'; approval: ProjectApproval }
  | { kind: 'pending'; approval: ProjectApproval };

let state: ViewState = { kind: 'invalid' };

if (token) {
  const db = getDB(Astro.locals);
  const tokenHash = await sha256Hex(token);
  const row = await db
    .prepare('SELECT * FROM project_approvals WHERE token_hash = ? LIMIT 1')
    .bind(tokenHash)
    .first<ProjectApproval>();

  if (row) {
    const now = Date.now();
    if (row.status !== 'pending') {
      state = { kind: 'decided', approval: row };
    } else if (row.expires_at !== null && row.expires_at < now) {
      state = { kind: 'expired', approval: row };
    } else {
      state = { kind: 'pending', approval: row };
    }
  }
}

const fmtDate = (ms: number | null) =>
  ms ? new Date(ms).toLocaleString('pt-BR', { dateStyle: 'long', timeStyle: 'short' }) : '';
---

<BaseLayout
  title={
    state.kind === 'pending'
      ? `Aprovação — ${state.approval.project_title}`
      : 'Aprovação de projeto'
  }
>
  <main class="mx-auto max-w-3xl px-6 py-16">
    {state.kind === 'invalid' && (
      <section class="rounded-lg border border-red-500/30 bg-red-500/5 p-8 text-center">
        <h1 class="text-2xl font-bold text-red-300">Link inválido</h1>
        <p class="mt-2 text-neutral-400">
          Este link de aprovação não foi reconhecido. Verifique se a URL está completa
          ou solicite um novo link ao responsável pelo projeto.
        </p>
      </section>
    )}

    {state.kind === 'expired' && (
      <section class="rounded-lg border border-amber-500/30 bg-amber-500/5 p-8 text-center">
        <h1 class="text-2xl font-bold text-amber-300">Link expirado</h1>
        <p class="mt-2 text-neutral-400">
          Este link expirou em <strong>{fmtDate(state.approval.expires_at)}</strong>.
          Solicite um novo link ao responsável pelo projeto.
        </p>
      </section>
    )}

    {state.kind === 'decided' && (
      <section class="rounded-lg border border-neutral-700 bg-neutral-900/40 p-8 text-center">
        <h1 class="text-2xl font-bold">Projeto já {state.approval.status === 'approved' ? 'aprovado' : 'rejeitado'}</h1>
        <p class="mt-2 text-neutral-400">
          Você {state.approval.status === 'approved' ? 'aprovou' : 'rejeitou'} este projeto em
          <strong> {fmtDate(state.approval.decided_at)}</strong>.
        </p>
        {state.approval.comment && (
          <blockquote class="mx-auto mt-6 max-w-prose border-l-2 border-neutral-600 pl-4 text-left text-sm text-neutral-300">
            <strong class="block text-xs uppercase text-neutral-500">Seu comentário</strong>
            <span set:text={state.approval.comment} />
          </blockquote>
        )}
      </section>
    )}

    {state.kind === 'pending' && (
      <>
        <header class="mb-8">
          <p class="text-xs uppercase tracking-wider text-neutral-500">Aprovação de projeto</p>
          <h1 class="mt-2 text-3xl font-bold">{state.approval.project_title}</h1>
          {state.approval.project_summary && (
            <p class="mt-2 text-neutral-400">{state.approval.project_summary}</p>
          )}
          <p class="mt-3 text-sm text-neutral-500">
            Olá, <strong class="text-neutral-300">{state.approval.client_name}</strong>. Revise abaixo e dê seu parecer.
            {state.approval.expires_at && (
              <span> Este link expira em <strong>{fmtDate(state.approval.expires_at)}</strong>.</span>
            )}
          </p>
        </header>

        <article class="prose prose-invert max-w-none rounded-lg border border-neutral-800 bg-neutral-950 p-8">
          <Fragment set:html={state.approval.project_html ?? ''} />
        </article>

        <form id="approve-form" class="mt-10 space-y-5">
          <input type="hidden" name="token" value={token} />

          <label class="block">
            <span class="mb-1 block text-sm text-neutral-300">Comentário (opcional)</span>
            <textarea
              name="comment"
              rows="4"
              maxlength="2000"
              placeholder="Algum ajuste, dúvida ou observação?"
              class="w-full rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-neutral-100 outline-none focus:border-neutral-400"
            ></textarea>
          </label>

          <div class="flex flex-wrap items-center gap-3">
            <button
              type="submit"
              data-decision="approved"
              class="rounded-md bg-green-500 px-5 py-2.5 text-sm font-medium text-neutral-950 hover:bg-green-400 disabled:cursor-not-allowed disabled:opacity-50"
            >
              ✓ Aprovar projeto
            </button>
            <button
              type="submit"
              data-decision="rejected"
              class="rounded-md border border-red-500/40 bg-red-500/10 px-5 py-2.5 text-sm font-medium text-red-300 hover:bg-red-500/20 disabled:cursor-not-allowed disabled:opacity-50"
            >
              ✗ Rejeitar / pedir ajustes
            </button>
            <p id="approve-status" class="text-sm" aria-live="polite"></p>
          </div>
        </form>

        <script is:inline>
          const form = document.getElementById('approve-form');
          const status = document.getElementById('approve-status');
          let decision = null;

          form.querySelectorAll('button[data-decision]').forEach((b) => {
            b.addEventListener('click', () => { decision = b.dataset.decision; });
          });

          form.addEventListener('submit', async (ev) => {
            ev.preventDefault();
            if (!decision) return;
            if (decision === 'rejected' && !confirm('Confirmar rejeição? O responsável será notificado.')) return;

            const btns = form.querySelectorAll('button');
            btns.forEach((b) => (b.disabled = true));
            status.textContent = 'Enviando...';
            status.className = 'text-sm text-neutral-400';

            const fd = new FormData(form);
            try {
              const res = await fetch('/api/approve', {
                method: 'POST',
                body: JSON.stringify({
                  token: fd.get('token'),
                  decision,
                  comment: fd.get('comment') || null,
                }),
                headers: { 'Content-Type': 'application/json' },
              });
              const body = await res.json().catch(() => ({}));
              if (res.ok && body.ok) {
                window.location.reload();
                return;
              }
              status.textContent = body.error ?? `Erro ${res.status}`;
              status.className = 'text-sm text-red-400';
            } catch {
              status.textContent = 'Falha de conexão. Tente novamente.';
              status.className = 'text-sm text-red-400';
            } finally {
              btns.forEach((b) => (b.disabled = false));
            }
          });
        </script>
      </>
    )}
  </main>
</BaseLayout>
