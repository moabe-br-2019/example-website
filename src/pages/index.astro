---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { reader } from '../lib/keystatic';

const [settings, servicesRaw, projectsRaw] = await Promise.all([
  reader.singletons.siteSettings.read(),
  reader.collections.services.all(),
  reader.collections.projects.all(),
]);

const services = servicesRaw
  .map((s) => ({ slug: s.slug, ...s.entry }))
  .sort((a, b) => a.order - b.order);

const projects = projectsRaw
  .map((p) => ({ slug: p.slug, ...p.entry }))
  .sort((a, b) => {
    const ad = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
    const bd = b.publishedAt ? new Date(b.publishedAt).getTime() : 0;
    return bd - ad;
  })
  .slice(0, 3);

const siteName = settings?.siteName ?? 'Portfolio';
const tagline = settings?.tagline ?? '';
---

<BaseLayout title={siteName} description={tagline} faviconUrl={settings?.favicon ?? null}>
  <SiteHeader />

  <main>
    <section class="mx-auto max-w-6xl px-6 py-24 text-center">
      <h1 class="bg-gradient-to-br from-white to-neutral-500 bg-clip-text text-5xl font-bold leading-tight text-transparent sm:text-7xl">
        {tagline || siteName}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-400">
        Strategy, design and development for brands that want to grow online.
      </p>
      <div class="mt-10 flex justify-center gap-3">
        <a href="/contact" class="rounded-md bg-white px-5 py-2.5 text-sm font-medium text-neutral-900 hover:bg-neutral-200">
          Start a project
        </a>
        <a href="/projects" class="rounded-md border border-neutral-700 px-5 py-2.5 text-sm font-medium text-neutral-200 hover:border-neutral-500">
          See work
        </a>
      </div>
    </section>

    <section class="border-t border-neutral-800 bg-neutral-900/40">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <h2 class="text-3xl font-semibold">Services</h2>
        <p class="mt-2 text-neutral-400">What we deliver.</p>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((s) => (
            <article class="rounded-lg border border-neutral-800 bg-neutral-950 p-6 transition hover:border-neutral-600">
              <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-md bg-neutral-800 text-xs uppercase text-neutral-300">
                {s.icon?.slice(0, 2)}
              </div>
              <h3 class="text-lg font-semibold">{s.title}</h3>
              <p class="mt-2 text-sm text-neutral-400">{s.description}</p>
              <a href={`/services/${s.slug}`} class="mt-4 inline-block text-sm text-neutral-300 hover:text-white">
                Learn more →
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    {projects.length > 0 && (
      <section class="border-t border-neutral-800">
        <div class="mx-auto max-w-6xl px-6 py-20">
          <div class="flex items-end justify-between">
            <div>
              <h2 class="text-3xl font-semibold">Latest projects</h2>
              <p class="mt-2 text-neutral-400">Some of the work we've shipped recently.</p>
            </div>
            <a href="/projects" class="hidden text-sm text-neutral-300 hover:text-white sm:inline">
              See all →
            </a>
          </div>
          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {projects.map((p) => (
              <a href={`/projects/${p.slug}`} class="block overflow-hidden rounded-lg border border-neutral-800 bg-neutral-950 transition hover:border-neutral-500">
                {p.coverImage && (
                  <img src={p.coverImage} alt={p.title} class="aspect-video w-full object-cover" />
                )}
                <div class="p-5">
                  <p class="text-xs uppercase tracking-wider text-neutral-500">{p.client}</p>
                  <h3 class="mt-1 text-lg font-semibold">{p.title}</h3>
                  <p class="mt-2 text-sm text-neutral-400">{p.summary}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <SiteFooter />
</BaseLayout>
