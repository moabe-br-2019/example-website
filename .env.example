# --------------------------------------------------------------------------
# Variáveis públicas — disponíveis no client. PREFIXO PUBLIC_ é obrigatório.
# Copie para .env (local) e/ou defina em Cloudflare → Workers → Settings → Variables.
# --------------------------------------------------------------------------

# Site key do Cloudflare Turnstile (anti-spam no formulário de contato).
# Deixe vazio para desativar o widget.
PUBLIC_CF_TURNSTILE_SITE_KEY=

# --------------------------------------------------------------------------
# Segredos — NUNCA commitar. Em produção definir com:
#   npx wrangler secret put NOME
# Em dev local: criar .dev.vars (já está no .gitignore) com KEY=value.
# --------------------------------------------------------------------------

# Resend (email transacional)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfólio <noreply@seudominio.com>
CONTACT_TO_EMAIL=voce@seudominio.com
APPROVAL_NOTIFY_EMAIL=voce@seudominio.com

# Cloudflare Turnstile — server-side secret (validação do token).
CF_TURNSTILE_SECRET=

# Keystatic OAuth (modo github) — criar GitHub OAuth App em
# https://github.com/settings/developers e usar callback:
#   https://<seu-dominio>/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# String aleatória de 32+ chars usada pra assinar a sessão do Keystatic.
KEYSTATIC_SECRET=
